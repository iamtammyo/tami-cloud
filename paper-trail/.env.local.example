# Paper Trail runs local-first out of the box (no config needed).
# To enable Supabase (Postgres + Auth + Storage), set these and run supabase/schema.sql:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: set to "supabase" to switch the data layer off local storage.
NEXT_PUBLIC_DATA_BACKEND=local
