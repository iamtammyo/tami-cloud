# ── Site credentials ─────────────────────────────────────────────
# A site is only checked when both its email and password are set.

# VFS Global (Nigeria → Portugal): https://visa.vfsglobal.com/nga/en/prt/login
VFS_EMAIL=
VFS_PASSWORD=
# Booking-page dropdown choices (case-insensitive substring match).
# Category/subcategory default to "Digital Nomad"; centre defaults to the
# first option. Set explicitly if you need something different.
VFS_CENTRE=
#VFS_CATEGORY=Digital Nomad
#VFS_SUBCATEGORY=Digital Nomad

# BLS Spain (Nigeria): https://nigeria.blsspainglobal.com
BLS_EMAIL=
BLS_PASSWORD=
#BLS_VISA_TYPE=Digital Nomad

# ── Notifications (configure at least one channel) ───────────────
# ntfy.sh — easiest instant phone push, no account needed:
# 1. Install the "ntfy" app (iOS/Android) and subscribe to a topic with a
#    hard-to-guess name, e.g. tami-visa-slots-x7k2m9
# 2. Put the same topic name here. Slot alerts are sent as "urgent" priority.
NTFY_TOPIC=
#NTFY_SERVER=https://ntfy.sh
# Telegram: message @BotFather to create a bot (get the token), then message
# your bot once and visit https://api.telegram.org/bot<TOKEN>/getUpdates to
# find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Gmail: create an App Password at
# https://myaccount.google.com/apppasswords (requires 2FA on the account).
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset:
NOTIFY_TO=

# ── Optional ─────────────────────────────────────────────────────
# Residential/ISP proxy, e.g. http://host:port — datacenter IPs (GitHub
# runners) are often blocked by Cloudflare on these sites.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Set HEADFUL=1 to watch the browser locally while debugging.
HEADFUL=
