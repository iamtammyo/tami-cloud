---
/* Temporary page body for routes that get built in a later phase. */
import SectionLabel from './SectionLabel.astro';

interface Props {
  label: string;
  index?: number;
  title: string;
  phase: number;
}
const { label, index, title, phase } = Astro.props;
---

<div class="wrap placeholder">
  <SectionLabel text={label} index={index} />
  <h1>{title}</h1>
  <p class="prose">This page arrives in phase {phase}. The masthead, navigation and footer around it are the phase 1 foundations.</p>
</div>

<style>
  .placeholder { padding-block: var(--space-xl); }
  h1 { margin-block: var(--space-s) var(--space-m); }
  p { color: var(--color-text-muted); }
</style>
