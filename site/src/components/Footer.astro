---
import { footerNav, site, socials, visible } from '~/config/site';

interface Props {
  variant?: 'default' | 'quiet';
}
const { variant = 'default' } = Astro.props;
const year = new Date().getFullYear();
const socialLinks = visible(socials);
---

<footer class:list={['footer', variant]}>
  <div class="wrap footer-inner">
    <div class="sign-off">
      <p class="footer-name">{site.name}</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <nav aria-label="Footer">
      <p class="label" id="footer-site">Site</p>
      <ul aria-labelledby="footer-site">
        {visible(footerNav).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    {
      socialLinks.length > 0 && (
        <nav aria-label="Elsewhere">
          <p class="label" id="footer-elsewhere">Elsewhere</p>
          <ul aria-labelledby="footer-elsewhere">
            {socialLinks.map((item) => (
              <li><a href={item.href} rel="me noopener">{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )
    }

    <p class="small">&copy; {year} {site.name}. Photographs may not be reused without permission.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--color-text);
    font-size: var(--step--1);
  }
  .footer-inner {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    padding-block: var(--space-xl) var(--space-l);
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    margin-bottom: var(--space-2xs);
  }
  ul { padding: 0; list-style: none; margin-top: var(--space-2xs); }
  li + li { margin-top: var(--space-3xs); }
  nav a { color: var(--color-text); text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .small {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-rule);
  }
  .quiet { border-top-color: var(--color-rule); }
</style>
