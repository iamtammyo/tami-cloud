---
import { getPage, getSite } from '~/lib/content';

const site = await getSite();
const { footerLabel } = await getPage('photography');
const instagram = site.photographyInstagram || site.social('Instagram');
---

<footer class="photo-footer grain-strong">
  <span>{footerLabel}: <a href={site.emailHref}>{site.emailText}</a></span>
  <span class="links">
    {instagram && <a href={instagram} rel="me noopener">Instagram</a>}
    {site.social('LinkedIn') && <a href={site.social('LinkedIn')} rel="me noopener">LinkedIn</a>}
  </span>
</footer>

<style>
  .photo-footer {
    background: var(--terracotta);
    padding: 40px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    font-size: var(--text-sm);
    overflow: hidden;
  }
  a { color: var(--ink); }
  .links { display: flex; gap: 20px; }
</style>
