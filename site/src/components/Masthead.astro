---
import { mainNav, site, visible } from '~/config/site';

interface Props {
  variant?: 'default' | 'quiet';
}
const { variant = 'default' } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class:list={['masthead', variant]}>
  <div class="wrap masthead-inner">
    <a class="name" href="/" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          visible(mainNav).map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--color-text);
  }
  .masthead-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-m) var(--space-s);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-variation-settings: 'opsz' 144;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding-block: var(--space-3xs);
    font-family: var(--font-label);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--color-accent-light); }
  nav a[aria-current='page'] { border-bottom-color: var(--color-accent); }

  /* Photography: lighter rule, smaller name, less chrome */
  .quiet { border-bottom-color: var(--color-rule); }
  .quiet .name { font-size: var(--step-2); }
  .quiet nav a { color: var(--color-text-muted); }
  .quiet nav a[aria-current='page'] { color: var(--color-text); }
</style>
