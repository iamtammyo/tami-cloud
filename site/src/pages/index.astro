---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Headline from '~/components/Headline.astro';
import { getPage, getSite, SITE_NAME } from '~/lib/content';

const site = await getSite();
const home = await getPage('home');
const tilts = [-1.2, 0.8, -0.4];
// An external card with no link of its own points at the writing portfolio; cards with nowhere to go are hidden.
const cards = home.cards
  .map((card) => {
    const href = card.link || (card.external ? site.writingUrl : '');
    return { ...card, href, external: card.external || /^https?:/.test(href) };
  })
  .filter((card) => card.href);
const portrait = home.portrait.image;
---

<Base header={false} person>
  <div class="split">
    <section class="panel grain-strong" aria-label="Introduction">
      {
        portrait ? (
          <Image
            class="portrait-img"
            src={portrait}
            alt={home.portrait.alt}
            widths={[480, 800, 1200, 1600].filter((w) => w <= portrait.width)}
            sizes="(min-width: 960px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="portrait" aria-hidden="true"><span>[Your portrait, full bleed]</span></div>
        )
      }
      <div class="panel-top">
        <h1 class="name">{SITE_NAME}</h1>
        <nav aria-label="Main">
          <ul role="list">
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href} {...(item.external && { target: '_blank', rel: 'noopener' })}>
                    {item.external ? 'Writing portfolio' : item.label}
                    {item.external && <span aria-hidden="true"> ↗</span>}
                    {item.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <ul class="socials" role="list" aria-label="Elsewhere">
        {site.socials.map((s) => <li><a href={s.url} rel="me noopener">{s.platform}</a></li>)}
      </ul>
    </section>

    <section class="intro grain" aria-labelledby="intro-title">
      <p class="eyebrow">{home.eyebrow}</p>
      <Headline as="h2" id="intro-title" class="intro-title" text={home.headline} />
      <p class="lead">{home.intro}</p>

      <ul class="cards" role="list">
        {
          cards.map((card, i) => {
            const { href, external } = card;
            return (
              <li style={`--tilt:${tilts[i % tilts.length]}deg`}>
                <a class:list={['card', card.colour]} href={href} {...(external && { target: '_blank', rel: 'noopener' })}>
                  <span class="card-top">
                    <span class="eyebrow card-num">{String(i + 1).padStart(2, '0')}</span>
                    {card.photo.image ? (
                      <Image class="card-img" src={card.photo.image} alt={card.photo.alt} width={116} height={140} />
                    ) : external ? (
                      <span class="card-arrow" aria-hidden="true">↗</span>
                    ) : (
                      <span class="card-photo" aria-hidden="true">photo</span>
                    )}
                  </span>
                  <span class="card-bottom">
                    <span class="serif card-title">{card.title}</span>
                    <span class="card-text">{card.text}</span>
                    {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>

  <section class="brands band grain-strong" aria-label="Brands and contact">
    <div class="brands-inner">
      <div class="brands-list">
        <p class="eyebrow">{home.brandsHeading}</p>
        <ul role="list">
          {
            home.brands.map((b) => (
              <li>{b.logo ? <Image class="logo" src={b.logo} alt={b.name} height={32} /> : <span>{b.name}</span>}</li>
            ))
          }
        </ul>
      </div>
      <div class="hello">
        <Headline as="h2" class="hello-title" text="Say _hello_" />
        <a href={site.emailHref}>{site.emailText} ›</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .split { display: flex; flex-wrap: wrap; }

  /* Left: dark panel with portrait */
  .panel {
    flex: 1 1 480px;
    min-height: min(900px, 100svh);
    background: var(--ink);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: 40px 44px;
    overflow: hidden;
  }
  .portrait {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    place-items: center;
  }
  .portrait span {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    color: var(--sand);
    border: 1.5px dashed var(--muted);
    padding: 10px 16px;
  }
  .portrait-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  /* Darken the top and bottom so the name, nav and socials stay readable over the photo */
  .panel:has(.portrait-img)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(rgb(30 26 23 / 0.75), rgb(30 26 23 / 0.1) 35%, rgb(30 26 23 / 0.1) 70%, rgb(30 26 23 / 0.75));
  }
  .panel-top { display: flex; flex-direction: column; gap: 22px; }
  .name {
    font-weight: 300;
    font-size: clamp(3rem, 2rem + 4vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .panel ul { display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .panel .socials { gap: 4px; font-size: var(--text-sm); }
  .panel a { color: var(--paper); text-decoration: none; }
  .panel a:hover { text-decoration: underline; }

  /* Right: intro and cards */
  .intro {
    flex: 1 1 480px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 56px var(--gutter) 64px;
    overflow: hidden;
  }
  .intro :global(.intro-title) {
    font-size: clamp(2.375rem, 1.6rem + 2.6vw, 3.625rem);
    line-height: 1.06;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 16px;
    margin-top: 8px;
  }
  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    height: 100%;
    min-height: 230px;
    padding: 18px;
    border: var(--rule);
    color: var(--ink);
    text-decoration: none;
    transform: rotate(var(--tilt));
    transition: transform 0.25s ease;
  }
  .card:hover { color: var(--ink); transform: rotate(0deg) translateY(-3px); }
  .paper { background: var(--paper); }
  .periwinkle { background: var(--periwinkle); }
  .periwinkle .card-num { color: var(--ink); }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .card-num { font-size: 11px; }
  .card-photo {
    width: 58px; height: 70px;
    display: grid; place-items: center;
    font-size: 9px;
    background: var(--sand);
    border: 1.5px dashed var(--muted);
    color: var(--muted);
  }
  .periwinkle .card-photo { background: var(--periwinkle-deep); border-color: var(--ink); color: var(--ink); }
  .card-img { width: 58px; height: 70px; object-fit: cover; border: 1.5px solid var(--ink); }
  .card-arrow {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    color: var(--blue);
  }
  .card-bottom { display: flex; flex-direction: column; gap: 6px; }
  .card-title { font-size: var(--card-title); line-height: 1; }
  .card-text { font-size: var(--text-sm); line-height: 1.4; }

  /* Brands band */
  .brands { background: var(--periwinkle-deep); --script: var(--paper); }
  .brands-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-end;
    justify-content: space-between;
    max-width: 75rem;
    margin-inline: auto;
  }
  .brands-list { flex: 1 1 420px; display: flex; flex-direction: column; gap: 16px; }
  .brands-list .eyebrow { color: var(--ink); }
  .brands-list ul { display: flex; flex-wrap: wrap; gap: 12px; }
  .brands-list li {
    flex: 1 1 120px;
    height: 56px;
    display: grid;
    place-items: center;
    border: 1.5px dashed var(--ink);
    font-size: var(--text-sm);
    padding: 8px;
  }
  .brands-list :global(.logo) { width: auto; max-height: 32px; }
  .hello { flex: 0 1 360px; display: flex; flex-direction: column; gap: 10px; }
  .hello :global(.hello-title) { font-size: var(--display-xs); line-height: 1.1; }
  .hello a { color: var(--ink); }
</style>
